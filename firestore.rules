rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "anghks12@gmail.com",
          "dolsaen@gmail.com"
        ];
    }

    function userRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.token.email)).data;
    }

    function canManageWords() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email))
          && userRole().permissions.manageWords == true
        );
    }

    function canManageUsers() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email))
          && userRole().permissions.manageUsers == true
        );
    }

    function canViewLogs() {
      return isSuperAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/userRoles/$(request.auth.token.email))
          && userRole().permissions.viewLogs == true
        );
    }

    function hasOnlyWordFields() {
      return request.resource.data.keys().hasOnly(["hanja", "reading", "stageGroup"]);
    }

    function hasValidWordFields(wordId) {
      return hasOnlyWordFields()
        && request.resource.data.hanja == wordId
        && request.resource.data.hanja is string
        && request.resource.data.reading is string
        && request.resource.data.stageGroup is string
        && request.resource.data.stageGroup in ["level12", "level34", "level567"];
    }

    function hasOnlyRankingFields() {
      return request.resource.data.keys().hasOnly(["nickname", "score", "updatedAt"]);
    }

    function hasValidRankingFields(nickname) {
      return hasOnlyRankingFields()
        && request.resource.data.nickname == nickname
        && request.resource.data.nickname is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.updatedAt is number;
    }

    match /words/{wordId} {
      allow read: if true;
      allow create, update: if canManageWords() && hasValidWordFields(wordId);
      allow delete: if canManageWords();
    }

    match /ranking/{nickname} {
      allow read: if true;
      allow create: if hasValidRankingFields(nickname);
      allow update: if hasValidRankingFields(nickname)
        && resource.data.nickname == nickname
        && request.resource.data.score > resource.data.score
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isSuperAdmin();
    }

    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if canViewLogs();
      allow update, delete: if isSuperAdmin();
    }

    match /userRoles/{userId} {
      allow read: if isSuperAdmin()
        || (request.auth != null && request.auth.token.email == userId);
      allow create, update, delete: if canManageUsers();
    }

    match /futureProjects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
